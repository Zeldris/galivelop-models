{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gmod.licenses/0",
  "type": "object",
  "required": [
    "kind",
    "licenses"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "gmod.licenses/0"
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "spdx",
          "name",
          "url",
          "uses",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "spdx": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "uses": {
            "type": "array",
            "items": {
              "enum": [
                "commercial",
                "redistribute",
                "derivatives"
              ]
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
