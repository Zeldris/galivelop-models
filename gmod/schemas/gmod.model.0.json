{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gmod.model/0",
  "description": "Un Modelo con sus Variantes (docs/ddd.md secciones 2, 4 y 5). Lo que el esquema no expresa (campos por origen, base de un LoRA, ids unicos, licencia existente, suma de bytes) lo comprueba gmod.catalog.",
  "type": "object",
  "required": [
    "kind",
    "id",
    "name",
    "tasks",
    "provenance",
    "variants"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "gmod.model/0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "text",
          "embed",
          "image",
          "stt",
          "tts",
          "vision"
        ]
      }
    },
    "base": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Id del modelo base de un LoRA (D-8)."
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "consumer",
          "path",
          "commit",
          "key"
        ],
        "additionalProperties": false,
        "properties": {
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "required": [
        "id",
        "format",
        "quantization",
        "license",
        "bytes",
        "runtimes",
        "source",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*:[a-z0-9_]+-[a-z0-9_]+$"
        },
        "format": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "quantization": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "license": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "licenseNotes": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "minVersion"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "minVersion": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "layers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "integer",
              "minimum": 0
            },
            "projector": {
              "type": "integer",
              "minimum": 0
            },
            "draft": {
              "type": "integer",
              "minimum": 0
            },
            "other": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "memoryHints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "consumer",
              "machine",
              "minFreeMiB",
              "confirmed",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "consumer": {
                "type": "string",
                "minLength": 1
              },
              "machine": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "minFreeMiB": {
                "type": "integer",
                "minimum": 1
              },
              "confirmed": {
                "type": "boolean"
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "hf",
            "url",
            "ollama"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "role",
        "name",
        "bytes",
        "sha256",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "hf": {
          "type": "object",
          "required": [
            "repo",
            "revision",
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string",
              "pattern": "^[^/]+/[^/]+$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
